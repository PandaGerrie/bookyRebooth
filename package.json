{
  "name": "booky-rebooth-cms",
  "version": "1.0.0",
  "description": "Custom multi-tenant CMS for Booky Rebooth",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,admin -c green,cyan \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build": "npm run build:api && npm run build:admin",
    "build:api": "tsc",
    "build:admin": "vite build --config admin/vite.config.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandaGerrie/bookyRebooth.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/PandaGerrie/bookyRebooth/issues"
  },
  "homepage": "https://github.com/PandaGerrie/bookyRebooth#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-select": "^5.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-select": "^5.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
