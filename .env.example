# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/booky_cms"

PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Used by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional demo tenant + entity admin (set to "true" to create)
SEED_DEMO="false"
SEED_DEMO_ENTITY_NAME="Demo Dealer"
SEED_DEMO_ENTITY_SLUG="demo-dealer"
SEED_DEMO_ADMIN_EMAIL="dealer@example.com"
SEED_DEMO_ADMIN_PASSWORD="ChangeMe123!"

# Microsoft Graph (app-only) for seller calendar connectivity
# Needs application permission: Calendars.Read or Schedule.Read.All (admin consent)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TIMEZONE="Europe/Brussels"
